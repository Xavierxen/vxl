# Copy to .env (local) or add in Vercel → Settings → Environment Variables.

# REQUIRED. Supabase → Project Settings → Database → Connection string → "Connection pooler" (Transaction, port 6543).
# Looks like: postgresql://postgres.<project-ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Do NOT use the direct db.<ref>.supabase.co host on Vercel (IPv6 only). URL-encode special characters in the password (@ → %40).
SUPABASE_DB_URL=

# OPTIONAL but recommended: profile pictures and banners go to Supabase Storage (bucket "profile-media" is created for you).
# Without these they are stored in the database instead, which also works.
# Supabase → Project Settings → API → Project URL and the service_role key (keep it secret, server only).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Only with a custom domain:
# SERVER_ORIGIN=https://kanime.example.com
